{
  "manifest_version": 3,
  "name": "Save to Anytype",
  "version": "0.2.3",
  "description": "Save important web pages with your selected text in Markdown format to Anytype.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "tabs",
    "contextMenus",
    "alarms",
    "sidePanel",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "strip_origin_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "author": "lazjedi, diemonic1",
  "homepage_url": "https://github.com/lazjedi/Save-to-Anytype",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png",
    "256": "assets/icon256.png",
    "512": "assets/icon512.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png",
      "256": "assets/icon256.png",
      "512": "assets/icon512.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/popup/popup.html",
        "src/popup-blocked/popup-blocked.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/overlay.js",
        "src/content/element-selector.js",
        "src/content/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "default_locale": "en"
}
